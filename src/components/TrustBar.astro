---
import Icon from "./Icon.astro";
import { trustBadges } from "../data/site";
---

<section aria-label="Why customers trust LAO" class="bg-sage-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {trustBadges.map((badge) => (
        <li class="flex items-center justify-center gap-3 rounded-2xl bg-neutral-950 px-4 py-6 text-center text-white sm:px-6">
          <Icon name={badge.icon} class="size-5 shrink-0 text-brand-300" />
          <span class="text-sm font-bold sm:text-base">{badge.title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
