---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { site, footerLinks } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-brand-900 text-white">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-800/60 via-brand-900 to-neutral-950"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-2">
        <Logo variant="light" />
        <p class="mt-4 max-w-sm text-sm text-brand-100">
          From your neighborhood to your doorstep, {site.name} brings convenience closer.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href={site.social.instagram} aria-label="LAO on Instagram" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="instagram" class="size-4" />
          </a>
          <a href={site.social.facebook} aria-label="LAO on Facebook" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="facebook" class="size-4" />
          </a>
          <a href={site.social.linkedin} aria-label="LAO on LinkedIn" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="linkedin" class="size-4" />
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Support</h3>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          {footerLinks.support.map((item) => (
            <li>
              <a href="#services" class="transition-colors hover:text-white">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <div id="contact">
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Company</h3>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          {footerLinks.company.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">{item.label}</a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-brand-100">
          <a href={`mailto:${site.supportEmail}`} class="hover:text-white">{site.supportEmail}</a>
        </p>
        <p class="mt-1 text-sm text-brand-100">
          <a href={`tel:${site.supportPhone}`} class="hover:text-white">{site.supportPhone}</a>
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-sm text-brand-200">&copy; {year} {site.fullName}. Made for Bharat.</p>
      <a
        href={site.playStoreUrl}
        class="flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2.5 transition-colors hover:bg-white/20"
      >
        <Icon name="play" class="size-5 text-brand-300" />
        <span class="text-left leading-tight">
          <span class="block text-[10px] text-brand-200">GET IT ON</span>
          <span class="block text-sm font-semibold">Google Play</span>
        </span>
      </a>
    </div>
  </div>
</footer>
