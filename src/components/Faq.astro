---
import Icon from "./Icon.astro";
import { faqs } from "../data/site";
---

<section id="faq" aria-labelledby="faq-heading" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 id="faq-heading" class="text-center text-3xl font-extrabold text-brand-900 sm:text-4xl">
      Frequently Asked Questions
    </h2>

    <div class="mt-10 divide-y divide-sage-200 rounded-2xl border border-sage-200">
      {faqs.map((item) => (
        <details class="group px-5 py-4 open:bg-sage-100/60 first:rounded-t-2xl last:rounded-b-2xl">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-900">
            {item.question}
            <Icon name="chevron-down" class="size-5 shrink-0 text-brand-600 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-3 text-sm text-neutral-600">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
