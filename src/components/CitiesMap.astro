---
import Icon from "./Icon.astro";
import { nearbyCities, site } from "../data/site";
---

<section id="cities" aria-labelledby="cities-heading" class="bg-sage-200 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="mx-auto w-full max-w-lg">
        <img
          src="/images/mp-map.webp"
          alt="Map of Madhya Pradesh with LAO's launch city Mandideep pinned, alongside nearby cities Bhopal, Indore, Gwalior, Jabalpur, Ujjain and Dewas"
          width="1100"
          height="721"
          loading="lazy"
          class="h-auto w-full"
        />
      </div>

      <div>
        <h2 id="cities-heading" class="text-3xl font-extrabold text-brand-900 sm:text-4xl">
          This Is Where LAO Begins.
        </h2>
        <p class="mt-4 flex items-center gap-2 text-lg font-bold text-brand-700">
          <Icon name="pin" class="size-5" />
          {site.foundingCity}
        </p>
        <p class="mt-4 max-w-md text-neutral-600">
          Our first city. Our first community. The starting point for a faster India.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {nearbyCities.map((city) => (
            <li class="rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-semibold text-brand-800">
              {city}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
