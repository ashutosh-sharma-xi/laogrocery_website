---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { whyLaoPoints, site } from "../data/site";
---

<section id="why-lao" aria-labelledby="why-lao-heading" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Phone mockup comes first on mobile (matches the app-first framing),
           then swaps to the right column on desktop. -->
      <div class="order-1 flex justify-center lg:order-2">
        <div class="relative w-64 rounded-[2.5rem] border-8 border-neutral-900 bg-neutral-900 shadow-2xl sm:w-72">
          <div class="absolute left-1/2 top-0 h-5 w-28 -translate-x-1/2 rounded-b-2xl bg-neutral-900" aria-hidden="true"></div>
          <div class="overflow-hidden rounded-[2rem] bg-sage-100">
            <div class="flex h-11 items-center justify-between px-5 pt-3 text-[10px] font-semibold text-brand-900">
              <span>9:41</span>
              <span>●●●</span>
            </div>
            <div class="px-6 pb-8 pt-2">
              <Logo imgClass="h-5 w-auto" />
              <p class="mt-6 text-xl font-bold text-brand-900">Log In</p>
              <p class="mt-1 text-xs text-neutral-500">Sign in to access your LAO account.</p>

              <label class="mt-5 block text-xs font-semibold text-brand-900" for="phone-mock">Mobile Number</label>
              <div id="phone-mock" class="mt-1 rounded-lg border border-brand-200 bg-white px-3 py-2.5 text-xs text-neutral-400">
                Enter your number
              </div>

              <label class="mt-4 block text-xs font-semibold text-brand-900" for="password-mock">Password</label>
              <div id="password-mock" class="mt-1 rounded-lg border border-brand-200 bg-white px-3 py-2.5 text-xs text-neutral-400">
                Enter password
              </div>
              <p class="mt-1 text-right text-[10px] font-semibold text-brand-600">Forgot Password?</p>

              <div class="mt-5 rounded-full bg-brand-700 py-2.5 text-center text-xs font-bold text-white">
                Log In
              </div>
              <p class="mt-4 text-center text-[10px] text-neutral-500">
                Don't have an account? <span class="font-semibold text-brand-700">Register</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="order-2 lg:order-1">
        <h2 id="why-lao-heading" class="text-3xl font-extrabold text-brand-900 sm:text-4xl">
          Built for Your City
        </h2>
        <p class="mt-4 max-w-md text-neutral-600">
          Tier 3 cities deserve metro-quality service. {site.name} built for your neighborhood, budget, and lifestyle.
        </p>

        <ol class="mt-8 space-y-6">
          {whyLaoPoints.map((point) => (
            <li class="flex gap-4">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-sage-200 text-lg font-bold text-brand-900">
                {point.number}
              </span>
              <div>
                <h3 class="font-bold text-brand-700">{point.title}</h3>
                <p class="mt-1 text-sm text-neutral-600">{point.description}</p>
              </div>
            </li>
          ))}
        </ol>

        <a
          href={site.playStoreUrl}
          class="mt-8 inline-flex items-center gap-2 rounded-lg bg-neutral-950 px-5 py-3 text-white"
        >
          <Icon name="play" class="size-5 text-brand-300" />
          <span class="text-left leading-tight">
            <span class="block text-[10px] text-neutral-300">GET IT ON</span>
            <span class="block text-sm font-semibold">Google Play</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
