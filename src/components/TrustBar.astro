---
import Icon from "./Icon.astro";
import { trustBadges } from "../data/site";
---

<section aria-label="Why customers trust LAO" class="bg-sage-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-2 overflow-hidden rounded-2xl bg-neutral-950 text-white sm:grid-cols-4">
      {trustBadges.map((badge, i) => (
        <li
          class:list={[
            "flex items-center justify-center gap-3 px-4 py-6 text-center sm:px-6",
            i % 2 === 0 ? "border-r border-white/15" : "",
            i < 2 ? "border-b border-white/15 sm:border-b-0" : "",
            i < trustBadges.length - 1 ? "sm:border-r" : "sm:border-r-0",
          ]}
        >
          <Icon name={badge.icon} class="size-5 shrink-0 text-brand-300" />
          <span class="text-sm font-bold sm:text-base">{badge.title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
