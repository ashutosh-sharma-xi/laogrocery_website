---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const collageItems = [
  { icon: "carrot", color: "bg-brand-100 text-brand-700" },
  { icon: "milk", color: "bg-sand-200 text-brand-800" },
  { icon: "cookie", color: "bg-brand-200 text-brand-800" },
  { icon: "leaf", color: "bg-sand-300 text-brand-800" },
  { icon: "sparkles", color: "bg-brand-100 text-brand-700" },
  { icon: "baby", color: "bg-sand-200 text-brand-800" },
];
---

<section class="relative overflow-hidden bg-sage-300">
  <div class="pointer-events-none absolute -left-16 top-10 size-56 rounded-full bg-sand-300/60 blur-sm" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-10 bottom-0 size-72 rounded-full bg-brand-200/50 blur-sm" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-12 lg:px-8 lg:py-24">
    <div class="animate-fade-up">
      <h1 class="text-4xl font-extrabold leading-tight text-brand-900 sm:text-5xl lg:text-[3.25rem]">
        <span class="text-brand-900">Get Groceries Delivered</span>
        <br />
        <span class="text-brand-600">or Pick Up In-Store.</span>
      </h1>

      <a
        href={site.playStoreUrl}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-700 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-brand-900/20 transition-transform hover:-translate-y-0.5 hover:bg-brand-800"
      >
        Download App
      </a>

      <div class="mt-10">
        <h2 class="text-xl font-bold text-brand-900">First Order, Free Delivery</h2>
        <p class="mt-1 max-w-md text-brand-800">
          Enjoy free delivery on your first order with {site.name} — and every home delivery after that is priced lower than your local store. Prefer to shop in person? Pick up the same discounted groceries at your nearest LAO store.
        </p>
      </div>
    </div>

    <div class="relative">
      <div class="grid grid-cols-3 gap-3 rounded-3xl bg-white/70 p-4 shadow-xl ring-1 ring-black/5 backdrop-blur sm:gap-4 sm:p-6">
        {collageItems.map((item) => (
          <div class={`flex aspect-square items-center justify-center rounded-2xl ${item.color}`}>
            <Icon name={item.icon} class="size-9 sm:size-12" />
          </div>
        ))}
      </div>
      <p class="sr-only">
        Photo collage of fresh produce, dairy, snacks, household and baby care products available on LAO.
      </p>
    </div>
  </div>
</section>
