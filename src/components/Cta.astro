---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section class="bg-brand-900 py-16 text-center sm:py-20" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <h2 id="cta-heading" class="text-3xl font-extrabold text-white sm:text-4xl">
      First Order on Us
    </h2>
    <p class="mt-4 text-brand-100">
      Download {site.name} now and get your first delivery completely free. No minimum order, no hidden charges, just fresh groceries at your doorstep.
    </p>
    <a
      href={site.playStoreUrl}
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-neutral-950 px-6 py-3.5 text-white transition-colors hover:bg-neutral-800"
    >
      <Icon name="play" class="size-6 text-brand-300" />
      <span class="text-left leading-tight">
        <span class="block text-[10px] text-neutral-300">GET IT ON</span>
        <span class="block text-base font-semibold">Google Play</span>
      </span>
    </a>
  </div>
</section>
